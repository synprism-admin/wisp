<UserControl x:Class="Wisp.UI.CalendarFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusM}" Padding="14" Width="300">
        <StackPanel>
            <!-- Now -->
            <TextBlock x:Name="BigTime" FontFamily="{DynamicResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="2,0,0,0"/>
            <TextBlock x:Name="LongDate" Foreground="{DynamicResource TextDim}" FontSize="12.5" Margin="3,0,0,0"/>
            <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,12"/>

            <!-- Month -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="9,5" Click="Next_Click" ToolTip="Next month">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{DynamicResource Text}"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="9,5" Click="Prev_Click" ToolTip="Previous month">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="11" Foreground="{DynamicResource Text}"/>
                </Button>
                <Button Style="{StaticResource Ghost}" Padding="6,4" HorizontalAlignment="Left" Click="Today_Click" ToolTip="Back to today">
                    <TextBlock x:Name="MonthTitle" FontWeight="SemiBold" FontSize="13.5"/>
                </Button>
            </DockPanel>
            <UniformGrid x:Name="WeekDays" Columns="7" Margin="0,8,0,2"/>
            <UniformGrid x:Name="Days" Columns="7" Rows="6"/>

            <!-- Time zones -->
            <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,12,0,6"/>
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="EditButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,3" Content="Edit" Click="Edit_Click"/>
                <TextBlock Text="TIME ZONES" Style="{StaticResource Label}" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel x:Name="Clocks"/>
            <ComboBox x:Name="AddZone" Style="{StaticResource Combo}" Margin="0,8,0,0" Visibility="Collapsed"
                      SelectionChanged="AddZone_Changed"/>
        </StackPanel>
    </Border>
</UserControl>
