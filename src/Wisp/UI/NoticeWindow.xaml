<Window x:Class="Wisp.UI.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisp" Width="560" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True" UseLayoutRounding="True">

    <Border Margin="16" CornerRadius="{DynamicResource RadiusL}" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Header_Drag" Background="Transparent">
                <Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}" VerticalAlignment="Center">
                    <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{DynamicResource AccentColor}"/></Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="TitleText" Margin="10,0,0,0" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Body: paragraphs and bullet lines, built in code -->
            <StackPanel x:Name="Body" Margin="0,14,0,0"/>

            <Button x:Name="LinkButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,4" Margin="0,8,0,0"
                    Click="Link_Click" Visibility="Collapsed">
                <TextBlock x:Name="LinkText" Foreground="{DynamicResource Accent}" TextDecorations="Underline" FontSize="12.5"/>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource Ghost}" Margin="0,0,8,0" Padding="14,7" Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Padding="18,7" Click="Primary_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
