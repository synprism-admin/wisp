<UserControl x:Class="Wisp.UI.DevicesFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusM}" Padding="16" Width="310">
        <StackPanel>
            <TextBlock Text="Devices" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="EmptyText" Margin="0,6,0,4" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" FontSize="12.5"
                       Text="No wireless devices are reporting a battery level. Bluetooth devices and Razer receivers are supported; other brands' USB receivers don't share theirs with Windows."/>
            <StackPanel x:Name="Rows" Margin="0,8,0,0"/>

            <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,10,0,8"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" Click="Refresh_Click" ToolTip="Check again now">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" Content="Bluetooth settings" Click="Settings_Click"/>
                <TextBlock x:Name="Updated" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextFaint}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
