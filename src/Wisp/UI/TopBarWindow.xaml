<Window x:Class="Wisp.UI.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisp Bar" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="TrayIconTemplate">
            <Border Width="30" Height="28" CornerRadius="{DynamicResource RadiusXS}" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Title}" ToolTipService.Placement="Bottom"
                    MouseEnter="TrayIcon_MouseEnter" MouseLeave="TrayIcon_MouseLeave" MouseMove="TrayIcon_MouseMove"
                    PreviewMouseDown="TrayIcon_MouseDown" PreviewMouseUp="TrayIcon_MouseUp" Loaded="TrayIcon_Loaded">
                <Grid>
                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- edit-mode badge: + to pin into the bar, - to send to the overflow -->
                    <Border x:Name="Badge" Width="12" Height="12" CornerRadius="6" Background="{DynamicResource Accent}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0"
                            Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="7" Foreground="{DynamicResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1">
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: brand / launcher, then the focused app -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Ghost}" Padding="10,5" Click="Brand_Click" ToolTip="Search apps (tap Win)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}" VerticalAlignment="Center">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource AccentColor}"/></Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="BrandText" Text="Wisp" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12.5"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FocusedApp" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            </StackPanel>

            <!-- Center clock (secondary screens; the island covers this on the main one) -->
            <TextBlock x:Name="CenterClock" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="12.5" Visibility="Collapsed"/>

            <!-- Right: status cluster -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MediaButton" Style="{StaticResource Ghost}" Padding="10,5" Click="Media_Click" Visibility="Collapsed"
                        ToolTip="Play / pause">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MediaIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Foreground="{DynamicResource Accent}"/>
                        <TextBlock x:Name="MediaText" Margin="7,0,0,0" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <!-- Notification area: ^ overflow, then the icons pinned to the bar -->
                <Button x:Name="OverflowButton" Style="{StaticResource Ghost}" Padding="8,5" Click="Overflow_Click" ToolTip="Show hidden icons">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="11"/>
                </Button>
                <ItemsControl x:Name="PinnedTray" ItemTemplate="{StaticResource TrayIconTemplate}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Popup x:Name="OverflowPopup" PlacementTarget="{Binding ElementName=OverflowButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-90" VerticalOffset="6">
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusM}" Padding="10" Width="214">
                        <StackPanel>
                            <ItemsControl x:Name="HiddenTray" ItemTemplate="{StaticResource TrayIconTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="HiddenEmpty" Text="No hidden icons" Foreground="{DynamicResource TextFaint}" FontSize="12" Margin="4,2"/>
                            <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,8"/>
                            <TextBlock x:Name="EditHint" Text="Click an icon to move it between the bar and here." TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextDim}" FontSize="11.5" Margin="4,0,4,6" Visibility="Collapsed"/>
                            <DockPanel>
                                <Button x:Name="EditTrayButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Padding="8,4" Content="Edit" Click="EditTray_Click"/>
                                <Button Style="{StaticResource Ghost}" Padding="8,4" HorizontalAlignment="Right" Click="Tray_Click"
                                        Content="Windows taskbar" ToolTip="Temporarily show the Windows taskbar"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button Style="{StaticResource Ghost}" Padding="9,5" Click="Network_Click" ToolTip="Network settings">
                    <TextBlock x:Name="NetIcon" Style="{StaticResource Icon}" Text="&#xE839;" FontSize="13" Foreground="{DynamicResource Text}"/>
                </Button>

                <Button Style="{StaticResource Ghost}" Padding="9,5" Click="Volume_Click" MouseWheel="Volume_Wheel" ToolTip="Scroll to change volume, click to mute">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VolIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="13" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="VolText" Margin="6,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Margin="6,0" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryIcon" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Text}"/>
                    <TextBlock x:Name="BatteryText" Margin="5,0,0,0" FontSize="12"/>
                </StackPanel>

                <Button x:Name="DateButton" Style="{StaticResource Ghost}" Padding="9,5" Click="Date_Click" ToolTip="Calendar and time zones">
                    <TextBlock x:Name="DateText" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                </Button>
                <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=DateButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6"/>

                <Button Style="{StaticResource Ghost}" Padding="9,5" Click="Power_Click" ToolTip="Power">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="13" Foreground="{DynamicResource Text}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
