<Window x:Class="Wisp.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisp" Width="760" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True">

    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0">
        <!-- The island. Its size animates between pill, activity and full panel. -->
        <Border x:Name="Shell" Width="148" Height="34" CornerRadius="17" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" ClipToBounds="True"
                RenderTransformOrigin="0.5,0" MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave"
                MouseLeftButtonUp="Shell_Click" MouseWheel="Shell_MouseWheel">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
            </Border.Effect>

            <Grid>
                <!-- ============ Pill ============ -->
                <Grid x:Name="PillLayer" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Orb" Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFFD2B8" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{DynamicResource AccentColor}" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="PillText" Grid.Column="1" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="PillEq" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle Width="2.5" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource Accent}" Margin="1,0"/>
                        <Rectangle Width="2.5" Height="10" RadiusX="1" RadiusY="1" Fill="{DynamicResource Accent}" Margin="1,0"/>
                        <Rectangle Width="2.5" Height="7" RadiusX="1" RadiusY="1" Fill="{DynamicResource Accent}" Margin="1,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Activity: listening / thinking / message / confirm ============ -->
                <Grid x:Name="ActivityLayer" Margin="16,10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="26" Height="26" VerticalAlignment="Top" Margin="0,1,0,0">
                        <Ellipse x:Name="ActivityHalo" Fill="{DynamicResource AccentSoft}"/>
                        <TextBlock x:Name="ActivityIcon" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"
                                   FontSize="13" HorizontalAlignment="Center" Text="&#xE720;"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ActivityTitle" FontSize="11" Foreground="{DynamicResource TextDim}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActivityText" FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="19"
                                   MaxWidth="560"/>
                    </StackPanel>

                    <!-- live mic waveform -->
                    <ItemsControl x:Name="Wave" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel x:Name="ConfirmButtons" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button Content="Not now" Style="{StaticResource Ghost}" Click="ConfirmNo_Click" Margin="0,0,6,0"/>
                        <Button Content="Allow" Style="{StaticResource AccentButton}" Click="ConfirmYes_Click" Padding="16,6"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Panel ============ -->
                <Grid x:Name="PanelLayer" Visibility="Collapsed" Margin="14,12,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton x:Name="TabHome" Style="{StaticResource Tab}" Content="Home" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabApps" Style="{StaticResource Tab}" Content="Apps" GroupName="tabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabClip" Style="{StaticResource Tab}" Content="Clipboard" GroupName="tabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabRoutines" Style="{StaticResource Tab}" Content="Routines" GroupName="tabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabControls" Style="{StaticResource Tab}" Content="Controls" GroupName="tabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabWallpaper" Style="{StaticResource Tab}" Content="Wallpaper" GroupName="tabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabPower" Style="{StaticResource Tab}" Content="Power" GroupName="tabs" Checked="Tab_Checked"/>
                        </StackPanel>
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" Padding="8,5" Click="Settings_Click" ToolTip="Settings">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">

                        <!-- ===== Home ===== -->
                        <Grid x:Name="PageHome">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                                    <TextBlock x:Name="Greeting" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DateLine" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBox x:Name="AskBox" DockPanel.Dock="Top" Style="{StaticResource Search}" Tag="Ask Wisp, or hold Alt+Win and talk…"
                                         KeyDown="AskBox_KeyDown"/>

                                <Border DockPanel.Dock="Top" Margin="0,10,0,0" CornerRadius="{DynamicResource RadiusM}" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="14,10">
                                    <TextBlock x:Name="LastReply" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" LineHeight="19"
                                               Text="Hold Ctrl+Win to dictate · Alt+Win to talk to Wisp · Ctrl+Shift to circle and ask."/>
                                </Border>

                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="TO-DO"/>
                                <TextBox x:Name="TodoBox" DockPanel.Dock="Bottom" Style="{StaticResource Search}" Tag="Add a to-do…"
                                         Margin="0,6,0,0" KeyDown="TodoBox_KeyDown"/>
                                <ListBox x:Name="TodoList" Style="{StaticResource List}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Done, Mode=OneWay}" Tag="{Binding Id}"
                                                          Click="Todo_Toggle">
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1" Text="{Binding DueText}" Foreground="{DynamicResource TextFaint}" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <StackPanel Grid.Column="2">
                                <!-- now playing -->
                                <Border CornerRadius="{DynamicResource RadiusM}" Padding="14,12" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF2A221E" Offset="0"/>
                                            <GradientStop Color="#FF1C1C20" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="NOW PLAYING"/>
                                        <TextBlock x:Name="NpTitle" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Nothing playing"/>
                                        <TextBlock x:Name="NpArtist" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,2">
                                            <Button Style="{StaticResource Ghost}" Click="Prev_Click"><TextBlock Style="{StaticResource Icon}" Text="&#xE892;" Foreground="{DynamicResource Text}"/></Button>
                                            <Button Style="{StaticResource Ghost}" Click="PlayPause_Click" Margin="8,0"><TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="18" Foreground="{DynamicResource Text}"/></Button>
                                            <Button Style="{StaticResource Ghost}" Click="Next_Click"><TextBlock Style="{StaticResource Icon}" Text="&#xE893;" Foreground="{DynamicResource Text}"/></Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- volume -->
                                <Grid Margin="4,14,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Ghost}" Padding="4" Click="Mute_Click">
                                        <TextBlock x:Name="VolIcon" Style="{StaticResource Icon}" Text="&#xE767;"/>
                                    </Button>
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource Volume}" Margin="8,0" ValueChanged="Volume_Changed"/>
                                    <TextBlock x:Name="VolText" Grid.Column="2" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Style="{StaticResource Label}" Text="COMING UP"/>
                                <ItemsControl x:Name="UpcomingList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding When}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="UpcomingEmpty" Margin="4,2" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                           Text="Nothing scheduled. Try “every weekday at 9, open Outlook and Teams.”" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- ===== Apps ===== -->
                        <DockPanel x:Name="PageApps" Visibility="Collapsed">
                            <TextBox x:Name="AppSearch" DockPanel.Dock="Top" Style="{StaticResource Search}" Tag="Search apps…"
                                     TextChanged="AppSearch_TextChanged" KeyDown="AppSearch_KeyDown"/>
                            <ListBox x:Name="AppList" Style="{StaticResource List}" Margin="0,8,0,0" MouseLeftButtonUp="AppList_Click"
                                     KeyDown="AppList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="{DynamicResource RadiusXS}" Background="{DynamicResource SurfaceHover}">
                                                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- ===== Clipboard ===== -->
                        <DockPanel x:Name="PageClip" Visibility="Collapsed">
                            <TextBox x:Name="ClipSearch" DockPanel.Dock="Top" Style="{StaticResource Search}" Tag="Search clipboard history…"
                                     TextChanged="ClipSearch_TextChanged"/>
                            <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="4,6,0,0"
                                       Text="Click to paste · Right-click to pin or remove"/>
                            <ListBox x:Name="ClipList" Style="{StaticResource List}" Margin="0,8,0,0" MouseLeftButtonUp="ClipList_Click">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="11" Foreground="{DynamicResource Accent}"
                                                           Visibility="{Binding PinVisibility}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Age}" Foreground="{DynamicResource TextFaint}" FontSize="11.5"/>
                                            </StackPanel>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Pin / unpin" Click="ClipPin_Click" Tag="{Binding Id}"/>
                                                    <MenuItem Header="Remove" Click="ClipRemove_Click" Tag="{Binding Id}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- ===== Routines ===== -->
                        <DockPanel x:Name="PageRoutines" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource TextDim}" Margin="4,0,0,8" TextWrapping="Wrap"
                                       Text="Say things like “every morning at 9, open Unity and Spotify” or “on Nov 10 at 11am, search Amazon for gift wrap.”"/>
                            <ListBox x:Name="RoutineList" Style="{StaticResource List}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Width="96">
                                                <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource DisplayFont}" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Repeat}" Foreground="{DynamicResource Accent}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Instruction}" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Id}" Click="Routine_Toggle"/>
                                                <Button Style="{StaticResource Ghost}" Padding="6" Margin="6,0,0,0" Tag="{Binding Id}" Click="Routine_Delete" ToolTip="Delete">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- ===== Controls ===== -->
                        <ScrollViewer x:Name="PageControls" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                          <StackPanel>
                            <Grid Margin="4,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border CornerRadius="{DynamicResource RadiusM}" Padding="14,12" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                                        <CheckBox x:Name="CtlAll" Style="{StaticResource Toggle}" Click="CtlAll_Click">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock x:Name="CtlAllTitle" Text="Wisp desktop" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Replace the taskbar with the top bar and dock, and theme Windows to match." Foreground="{DynamicResource TextDim}" FontSize="11.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <TextBlock Style="{StaticResource Label}" Text="DESKTOP"/>
                                    <CheckBox x:Name="CtlTaskbar" Style="{StaticResource Toggle}" Margin="4,6" Click="Ctl_Click" Content="Hide Windows taskbar"/>
                                    <CheckBox x:Name="CtlTopBar" Style="{StaticResource Toggle}" Margin="4,6" Click="Ctl_Click" Content="Top bar"/>
                                    <CheckBox x:Name="CtlDock" Style="{StaticResource Toggle}" Margin="4,6" Click="Ctl_Click" Content="Dock"/>
                                    <CheckBox x:Name="CtlIcons" Style="{StaticResource Toggle}" Margin="4,6" Click="Ctl_Click" Content="Hide desktop icons"/>
                                    <CheckBox x:Name="CtlWinKey" Style="{StaticResource Toggle}" Margin="4,6" Click="Ctl_Click" Content="Tap Win for the launcher"/>
                                    <TextBlock Style="{StaticResource Label}" Text="WINDOWS LOOK"/>
                                    <CheckBox x:Name="CtlTheme" Style="{StaticResource Toggle}" Margin="4,6" Click="Ctl_Click" Content="Theme Windows to match"/>
                                    <CheckBox x:Name="CtlTitleBars" Style="{StaticResource Toggle}" Margin="4,6" Click="Ctl_Click" Content="Accent on title bars"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Margin="4,0,0,6" Text="THEME"/>
                                    <ItemsControl x:Name="ThemeList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Tile}" Margin="0,0,6,6" Padding="10,8" Tag="{Binding Id}" Click="Theme_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="16" Height="16" CornerRadius="{DynamicResource RadiusXS}" Background="{Binding Swatch}" BorderBrush="{Binding Ring}" BorderThickness="2"/>
                                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Label}" Text="BRAND"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Rebrand" Margin="6,0,0,0" Click="Rebrand_Click"/>
                                        <TextBox x:Name="BrandBox" Style="{StaticResource Search}" Tag="Name shown in the bar and launcher"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource Tile}" Padding="12,6" Content="Import theme…" Click="ImportTheme_Click"/>
                                        <Button Style="{StaticResource Tile}" Padding="12,6" Margin="6,0,0,0" Content="Export…" Click="ExportTheme_Click"/>
                                        <Button Style="{StaticResource Tile}" Padding="12,6" Margin="6,0,0,0" Content="Open folder" Click="ThemeFolder_Click"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="CONNECTIVITY"/>
                                    <CheckBox x:Name="CtlWifi" Style="{StaticResource Toggle}" Margin="4,6" Click="Radio_Click" Content="Wi-Fi"/>
                                    <CheckBox x:Name="CtlBluetooth" Style="{StaticResource Toggle}" Margin="4,6" Click="Radio_Click" Content="Bluetooth"/>
                                </StackPanel>
                            </Grid>

                            <!-- ===== Customize: live theme editor ===== -->
                            <Border Margin="4,18,8,4" Padding="16,14" CornerRadius="{DynamicResource RadiusM}" Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}" Content="Reset" Click="CustReset_Click" ToolTip="Back to the theme this was based on"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Customize" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="CustNote" Foreground="{DynamicResource TextFaint}" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="ACCENT"/>
                                            <ItemsControl x:Name="AccentSwatches">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="26" Height="26" Margin="0,0,6,6" Tag="{Binding Hex}" Click="AccentSwatch_Click" Cursor="Hand" ToolTip="{Binding Hex}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <Ellipse Fill="{Binding Brush}"/>
                                                                        <Ellipse Stroke="{DynamicResource Text}" StrokeThickness="2" Visibility="{Binding Ring}"/>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox x:Name="AccentHex" Style="{StaticResource Search}" Tag="#RRGGBB" KeyDown="AccentHex_KeyDown" LostFocus="AccentHex_LostFocus"/>

                                            <TextBlock Style="{StaticResource Label}" Text="BACKGROUND"/>
                                            <ItemsControl x:Name="BackgroundSwatches">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="26" Height="26" Margin="0,0,6,6" Tag="{Binding Hex}" Click="BackgroundSwatch_Click" Cursor="Hand" ToolTip="{Binding Hex}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <Ellipse Fill="{Binding Brush}" Stroke="{DynamicResource Hairline}" StrokeThickness="1"/>
                                                                        <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="{Binding Ring}"/>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox x:Name="BackgroundHex" Style="{StaticResource Search}" Tag="#RRGGBB" KeyDown="BackgroundHex_KeyDown" LostFocus="BackgroundHex_LostFocus"/>

                                            <TextBlock Style="{StaticResource Label}" Text="FONT"/>
                                            <ComboBox x:Name="UiFontBox" Style="{StaticResource Combo}" SelectionChanged="Font_Changed"/>
                                            <TextBlock Style="{StaticResource Label}" Text="HEADING FONT"/>
                                            <ComboBox x:Name="HeadingFontBox" Style="{StaticResource Combo}" SelectionChanged="Font_Changed"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Label}" Text="TRANSPARENCY"/>
                                            <DockPanel>
                                                <TextBlock x:Name="TransparencyText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <Slider x:Name="TransparencySlider" Style="{StaticResource Volume}" Minimum="0" Maximum="50" ValueChanged="Shape_Changed"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="ROUNDNESS"/>
                                            <DockPanel>
                                                <TextBlock x:Name="RoundnessText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <Slider x:Name="RoundnessSlider" Style="{StaticResource Volume}" Minimum="0" Maximum="160" ValueChanged="Shape_Changed"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="DOCK ICON SIZE"/>
                                            <DockPanel>
                                                <TextBlock x:Name="DockSizeText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <Slider x:Name="DockSizeSlider" Style="{StaticResource Volume}" Minimum="24" Maximum="64" ValueChanged="Shape_Changed"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="DOCK POSITION"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="DockBottom" Style="{StaticResource Tab}" Content="Bottom" GroupName="dockpos" Checked="DockPos_Checked"/>
                                                <RadioButton x:Name="DockLeft" Style="{StaticResource Tab}" Content="Left" GroupName="dockpos" Checked="DockPos_Checked"/>
                                                <RadioButton x:Name="DockRight" Style="{StaticResource Tab}" Content="Right" GroupName="dockpos" Checked="DockPos_Checked"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="TOP BAR HEIGHT"/>
                                            <DockPanel>
                                                <TextBlock x:Name="BarHeightText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                                                <Slider x:Name="BarHeightSlider" Style="{StaticResource Volume}" Minimum="30" Maximum="56" ValueChanged="Shape_Changed"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="SAVE AS A NEW THEME"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Save" Margin="6,0,0,0" Click="CustSaveAs_Click"/>
                                                <TextBox x:Name="SaveAsName" Style="{StaticResource Search}" Tag="Theme name"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                          </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Wallpaper ===== -->
                        <DockPanel x:Name="PageWallpaper" Visibility="Collapsed">
                            <DockPanel.Resources>
                                <DataTemplate x:Key="WallThumb">
                                <Button Width="196" Height="110" Margin="0,0,8,8" Tag="{Binding Path}" Click="Wall_Click" Cursor="Hand"
                                        ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border CornerRadius="{DynamicResource RadiusS}" Background="{DynamicResource SurfaceHover}">
                                                    <Border CornerRadius="{DynamicResource RadiusS}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                                <Border x:Name="ring" CornerRadius="{DynamicResource RadiusS}" BorderThickness="3"
                                                        BorderBrush="{DynamicResource Accent}" Visibility="{Binding Ring}"/>
                                                <Border x:Name="hover" CornerRadius="{DynamicResource RadiusS}" BorderThickness="2"
                                                        BorderBrush="{DynamicResource Text}" Opacity="0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hover" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                                <ItemsPanelTemplate x:Key="WallPanel"><WrapPanel/></ItemsPanelTemplate>
                            </DockPanel.Resources>

                            <!-- fit + target screen -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fit" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    <RadioButton x:Name="FitFill" Style="{StaticResource Tab}" Content="Fill" GroupName="wfit" Checked="Fit_Checked" ToolTip="Cover the screen, cropping what doesn't fit (best for any size)"/>
                                    <RadioButton x:Name="FitFit" Style="{StaticResource Tab}" Content="Fit" GroupName="wfit" Checked="Fit_Checked" ToolTip="Show the whole image, with bars if the shape differs"/>
                                    <RadioButton x:Name="FitStretch" Style="{StaticResource Tab}" Content="Stretch" GroupName="wfit" Checked="Fit_Checked" ToolTip="Stretch to the screen exactly (may distort)"/>
                                    <RadioButton x:Name="FitCenter" Style="{StaticResource Tab}" Content="Center" GroupName="wfit" Checked="Fit_Checked" ToolTip="Actual size, centered"/>
                                    <RadioButton x:Name="FitSpan" Style="{StaticResource Tab}" Content="Span" GroupName="wfit" Checked="Fit_Checked" ToolTip="One image across all screens"/>
                                </StackPanel>
                                <StackPanel x:Name="ScreenPicker" Orientation="Horizontal" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- add / folder / credits -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Padding="12,6" Content="Add image…" Click="WallAdd_Click"/>
                                <Button DockPanel.Dock="Left" Style="{StaticResource Tile}" Padding="12,6" Margin="6,0,0,0" Content="Choose folder…" Click="WallFolder_Click"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" Click="WallCredits_Click"
                                        ToolTip="Included wallpapers are from the GNOME project (CC BY-SA 3.0)">
                                    <TextBlock Text="Credits" FontSize="11.5" Foreground="{DynamicResource TextFaint}"/>
                                </Button>
                                <TextBlock x:Name="WallFolderText" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"
                                           FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="2,0,0,0">
                                    <TextBlock x:Name="WallMineLabel" Style="{StaticResource Label}" Margin="2,0,0,8" Text="YOUR IMAGES"/>
                                    <ItemsControl x:Name="WallMine" ItemTemplate="{StaticResource WallThumb}" ItemsPanel="{StaticResource WallPanel}"/>
                                    <TextBlock Style="{StaticResource Label}" Margin="2,4,0,8" Text="INCLUDED"/>
                                    <ItemsControl x:Name="WallIncluded" ItemTemplate="{StaticResource WallThumb}" ItemsPanel="{StaticResource WallPanel}"/>
                                    <TextBlock Style="{StaticResource Label}" Margin="2,4,0,8" Text="FROM YOUR THEME"/>
                                    <ItemsControl x:Name="WallTheme" ItemTemplate="{StaticResource WallThumb}" ItemsPanel="{StaticResource WallPanel}"/>
                                    <TextBlock x:Name="WallFolderLabel" Style="{StaticResource Label}" Margin="2,4,0,8" Text="FOLDER"/>
                                    <ItemsControl x:Name="WallFolderItems" ItemTemplate="{StaticResource WallThumb}" ItemsPanel="{StaticResource WallPanel}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ===== Power ===== -->
                        <StackPanel x:Name="PagePower" Visibility="Collapsed" VerticalAlignment="Center">
                            <UniformGrid Columns="4" Margin="40,0">
                                <Button Style="{StaticResource Tile}" Margin="6" Padding="0,22" Click="Lock_Click">
                                    <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Lock" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Margin="6" Padding="0,22" Click="Sleep_Click">
                                    <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Sleep" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Margin="6" Padding="0,22" Click="Restart_Click">
                                    <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Restart" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Margin="6" Padding="0,22" Click="Shutdown_Click">
                                    <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Danger}"/>
                                        <TextBlock Text="Shut down" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                                </Button>
                            </UniformGrid>
                            <Button Style="{StaticResource Ghost}" HorizontalAlignment="Center" Margin="0,28,0,0"
                                    Click="Quit_Click" Foreground="{DynamicResource TextDim}" Content="Quit Wisp"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
