<UserControl x:Class="Wisp.UI.WeatherFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <FontFamily x:Key="Symbols">Segoe UI Symbol, Segoe UI Emoji</FontFamily>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusM}" Padding="16" Width="330">
        <StackPanel>
            <!-- No location yet -->
            <StackPanel x:Name="EmptyPanel">
                <TextBlock Text="Weather" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" FontSize="12.5"
                           Text="Add your zip code to see the weather here, and rain, snow or storms on your desktop when they're happening outside."/>
                <Button Style="{StaticResource AccentButton}" Padding="16,7" HorizontalAlignment="Left" Content="Set location" Click="Location_Click"/>
            </StackPanel>

            <!-- Conditions -->
            <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BigGlyph" FontFamily="{StaticResource Symbols}" FontSize="38" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="BigTemp" Grid.Column="1" FontFamily="{DynamicResource DisplayFont}" FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="Summary" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PlaceText" FontSize="12" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Details" Margin="2,10,0,0" FontSize="12" Foreground="{DynamicResource TextDim}"/>
                <TextBlock x:Name="ErrorText" Margin="2,6,0,0" FontSize="12" Foreground="{DynamicResource Danger}" Visibility="Collapsed"/>

                <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,12"/>
                <UniformGrid x:Name="Forecast" Columns="5"/>

                <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,12,0,8"/>
                <TextBlock Text="LIVE DESKTOP" Style="{StaticResource Label}" Margin="4,0,0,2"/>
                <TextBlock x:Name="LiveStatus" Margin="4,0,0,8" FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                <WrapPanel x:Name="Previews"/>

                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" Click="Refresh_Click" ToolTip="Refresh now">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" Content="Change location" Click="Location_Click"/>
                    <TextBlock x:Name="Updated" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextFaint}"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
