<Window x:Class="Wisp.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisp Launcher" Width="680" Height="520" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" UseLayoutRounding="True">

    <Border Margin="16" CornerRadius="24" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
            VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="12">
            <Grid>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="16" Margin="14,0,0,0" Foreground="{DynamicResource TextDim}"/>
                <TextBox x:Name="Query" FontSize="17" Padding="40,0,0,0" Height="46" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Accent}" VerticalContentAlignment="Center"
                         FontFamily="{DynamicResource UiFont}" TextChanged="Query_TextChanged" PreviewKeyDown="Query_KeyDown"/>
                <TextBlock x:Name="Placeholder" Text="Search apps, settings, windows… or ask anything" FontSize="17"
                           Margin="40,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" IsHitTestVisible="False"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Hairline}" Margin="4,8"/>
            <ListBox x:Name="Results" Style="{StaticResource List}" MaxHeight="400" MouseLeftButtonUp="Results_Click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="30" Height="30">
                                <Border CornerRadius="8" Background="{DynamicResource SurfaceHover}"/>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" FontSize="14"/>
                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
