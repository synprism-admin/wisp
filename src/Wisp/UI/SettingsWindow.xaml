<Window x:Class="Wisp.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisp Settings" Width="640" Height="760" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,10,0,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="{DynamicResource RadiusS}" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}"
                                BorderThickness="1" Padding="12,8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="{DynamicResource RadiusL}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="56" Background="Transparent" MouseLeftButtonDown="Header_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0">
                    <Ellipse Width="12" Height="12" Fill="{DynamicResource Accent}">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{DynamicResource AccentColor}"/></Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Wisp" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"/>
                    <TextBlock Text="Settings" Foreground="{DynamicResource TextDim}" FontSize="18" Margin="6,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" Margin="0,0,12,0" Padding="8,6" Click="Close_Click">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="22,12">
                <DockPanel>
                    <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource Good}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Ghost}" Content="Cancel" Click="Close_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="Save" Padding="22,7" Click="Save_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,22,16">
                <StackPanel>
                    <!-- ===== Brain ===== -->
                    <TextBlock Style="{StaticResource H}" Text="Brain" Margin="0,6,0,10"/>
                    <CheckBox x:Name="AiEnabled" Style="{StaticResource Toggle}" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="AI features"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="When off, Wisp never sends anything to an AI provider. Dictation still works, without clean-up. See the privacy policy for exactly what's sent when on."/>
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="UseClaude" Style="{StaticResource Tab}" Content="Claude" GroupName="prov"/>
                        <RadioButton x:Name="UseGemini" Style="{StaticResource Tab}" Content="Gemini" GroupName="prov"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Runs voice commands, PC control, circle-to-ask and dictation clean-up. Keys are encrypted for your Windows account."/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Claude API key"/>
                    <PasswordBox x:Name="ClaudeKey"/>
                    <TextBlock x:Name="ClaudeKeyHint" Style="{StaticResource Hint}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Claude model"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="9,6" Margin="6,0,0,0" Click="RefreshModels_Click" ToolTip="Refresh the model list">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                        </Button>
                        <ComboBox x:Name="ClaudeModel" Style="{StaticResource Combo}"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Gemini API key"/>
                    <PasswordBox x:Name="GeminiKey"/>
                    <TextBlock x:Name="GeminiKeyHint" Style="{StaticResource Hint}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Gemini model"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="9,6" Margin="6,0,0,0" Click="RefreshModels_Click" ToolTip="Refresh the model list">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                        </Button>
                        <ComboBox x:Name="GeminiModel" Style="{StaticResource Combo}"/>
                    </DockPanel>
                    <TextBlock x:Name="ModelsHint" Style="{StaticResource Hint}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Effort for commands (Claude)"/>
                    <ComboBox x:Name="AgentEffort" Style="{StaticResource Combo}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Lower is snappier; higher is better at multi-step PC tasks."/>

                    <Button Style="{StaticResource Tile}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,7" Click="Test_Click" Content="Test connection"/>
                    <TextBlock x:Name="TestResult" Style="{StaticResource Hint}"/>

                    <!-- ===== Voice ===== -->
                    <TextBlock Style="{StaticResource H}" Text="Voice"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Microphone"/>
                    <ComboBox x:Name="Mic" Style="{StaticResource Combo}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Speech model (runs locally on your GPU)"/>
                    <ComboBox x:Name="WhisperModel" Style="{StaticResource Combo}"/>
                    <TextBlock x:Name="WhisperStatus" Style="{StaticResource Hint}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Language"/>
                    <TextBox x:Name="Language" Style="{StaticResource Field}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Two-letter code like en, es, de, or 'auto' to detect."/>

                    <CheckBox x:Name="Cleanup" Style="{StaticResource Toggle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Clean up dictation"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Removes filler words and applies self-corrections before typing."/>
                        </StackPanel>
                    </CheckBox>

                    <!-- ===== You ===== -->
                    <TextBlock Style="{StaticResource H}" Text="You"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Your name"/>
                    <TextBox x:Name="UserName" Style="{StaticResource Field}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Personality"/>
                    <TextBox x:Name="Persona" Style="{StaticResource Field}" Tag="e.g. dry and witty, or calm and formal"/>

                    <!-- ===== Safety & system ===== -->
                    <TextBlock Style="{StaticResource H}" Text="Safety &amp; system"/>
                    <CheckBox x:Name="Confirm" Style="{StaticResource Toggle}">
                        <StackPanel>
                            <TextBlock Text="Ask before risky actions"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Shutdown, PowerShell, and plugin tools marked 'confirm'."/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="Startup" Style="{StaticResource Toggle}" Margin="0,14,0,0">
                        <TextBlock Text="Start Wisp when I sign in"/>
                    </CheckBox>

                    <!-- ===== Shortcuts ===== -->
                    <TextBlock Style="{StaticResource H}" Text="Shortcuts"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hold Ctrl + Win" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}" Margin="0,4"/>
                        <TextBlock Grid.Column="1" Text="Dictate into any app" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="Hold Alt + Win" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Talk to Wisp (commands, questions, PC control)" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="Hold Ctrl + Shift" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Circle something on screen and ask about it" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Text="Esc" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Cancel while holding" Margin="0,4"/>
                    </Grid>

                    <!-- ===== Plugins ===== -->
                    <TextBlock Style="{StaticResource H}" Text="Updates"/>
                    <DockPanel>
                        <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="16,7"
                                Content="Check for updates" Click="CheckUpdates_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="13"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox x:Name="AutoUpdates" Style="{StaticResource Toggle}" Margin="0,12,0,0">
                        <TextBlock Text="Check for updates automatically (once a day)"/>
                    </CheckBox>

                    <TextBlock Style="{StaticResource H}" Text="Plugins"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                               Text="Plugins connect Wisp to your own systems: JSON files that turn HTTP calls, PowerShell or commands into things you can ask for. They reload as soon as you save."/>
                    <TextBlock x:Name="PluginList" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"/>
                    <TextBlock x:Name="PluginErrors" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Tile}" Padding="14,7" Click="OpenPlugins_Click" Content="Open plugins folder"/>
                        <Button Style="{StaticResource Tile}" Padding="14,7" Margin="8,0,0,0" Click="OpenLogs_Click" Content="Open logs"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
