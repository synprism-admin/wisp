<Window x:Class="Wisp.UI.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wisp.UI"
        Title="Wisp Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>

    <!-- Floating dock, centered at the bottom of its strip -->
    <Border x:Name="Bar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
            CornerRadius="20" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
            Padding="8,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- launcher -->
            <Button x:Name="LauncherButton" Style="{StaticResource Ghost}" Width="52" Height="52" Padding="0" Click="Launcher_Click" ToolTip="Apps">
                <TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" FontSize="20" Foreground="{DynamicResource Text}"/>
            </Button>
            <Rectangle Width="1" Margin="6,10" Fill="{DynamicResource Hairline}"/>

            <ItemsControl x:Name="Items">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="54" Height="52" Margin="1,0" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonUp="Item_Click" MouseRightButtonUp="Item_RightClick" MouseUp="Item_MiddleClick"
                              MouseEnter="Item_Enter" MouseLeave="Item_Leave" ToolTip="{Binding Name}" ToolTipService.Placement="Top"
                              ToolTipService.InitialShowDelay="250">
                            <Border x:Name="Hover" CornerRadius="14" Background="{DynamicResource SurfaceHover}" Opacity="0"/>
                            <Border x:Name="Active" CornerRadius="14" Background="{DynamicResource AccentSoft}"
                                    Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                            <Grid Width="36" Height="36" RenderTransformOrigin="0.5,0.8">
                                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                                <Border CornerRadius="10" Background="{DynamicResource SurfaceHover}">
                                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <!-- running dots -->
                            <ItemsControl ItemsSource="{Binding DotCount, Converter={x:Static local:DotsConverter.Instance}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="4" Height="4" Margin="1.5,0" Fill="{DynamicResource Accent}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
