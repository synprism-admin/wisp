<Window x:Class="Wisp.UI.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wisp.UI"
        Title="Wisp Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <!-- Notification badge parts: shown by BadgeKind, popping in when they appear. -->
        <Storyboard x:Key="BadgePop">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.2" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.2" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Window.Resources>

    <!--
      The window is taller than the strip it reserves, so magnified icons can rise above the bar.
      BarBackground keeps the bar's fixed thickness; the icon row sits on it and grows past it.
    -->
    <Grid x:Name="BarHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
        <Border x:Name="BarBackground" VerticalAlignment="Bottom"
                CornerRadius="{DynamicResource RadiusL}" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <StackPanel x:Name="Row" Orientation="{Binding DockOrientation, RelativeSource={RelativeSource AncestorType=Window}}"
                    VerticalAlignment="Bottom" Margin="6" Background="Transparent"
                    MouseMove="Row_MouseMove" MouseLeave="Row_MouseLeave">
            <!-- launcher -->
            <Button x:Name="LauncherButton" Style="{StaticResource Ghost}" Width="{DynamicResource DockTile}" Height="{DynamicResource DockTile}"
                    Padding="0" VerticalAlignment="Bottom" Click="Launcher_Click" ToolTip="Apps">
                <TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" FontSize="20" Foreground="{DynamicResource Text}"/>
            </Button>
            <Rectangle x:Name="Divider" Width="1" Margin="6,10" Fill="{DynamicResource Hairline}"/>

            <ItemsControl x:Name="Items" VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding DockOrientation, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Magnification scales this through its LayoutTransform (set in code), so neighbours make room. -->
                        <Grid Width="{DynamicResource DockTile}" Height="{DynamicResource DockTile}" Margin="1"
                              VerticalAlignment="{Binding ItemVAlign, RelativeSource={RelativeSource AncestorType=Window}}"
                              HorizontalAlignment="{Binding ItemHAlign, RelativeSource={RelativeSource AncestorType=Window}}"
                              Background="Transparent" Cursor="Hand" Loaded="Item_Loaded"
                              PreviewMouseLeftButtonDown="Item_Press" MouseMove="Item_Move"
                              MouseLeftButtonUp="Item_Click" MouseRightButtonUp="Item_RightClick" MouseUp="Item_MiddleClick"
                              ToolTip="{Binding Name}"
                              ToolTipService.Placement="{Binding TooltipPlacement, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTipService.InitialShowDelay="350">
                            <Border CornerRadius="{DynamicResource RadiusM}" Background="{DynamicResource AccentSoft}"
                                    Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                            <Grid Width="{DynamicResource DockIcon}" Height="{DynamicResource DockIcon}">
                                <Border CornerRadius="{DynamicResource RadiusS}" Background="{DynamicResource SurfaceHover}">
                                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                                    </Image.Effect>
                                </Image>
                                <!-- notification badge: unread count, the app's own overlay, or a dot when it wants attention -->
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-7,0" IsHitTestVisible="False">
                                    <Border MinWidth="19" Height="19" CornerRadius="9.5" Padding="5,0" Background="{DynamicResource BadgeRed}"
                                            BorderBrush="{DynamicResource Surface}" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeKind}" Value="count">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource BadgePop}"/></DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image Source="{Binding BadgeIcon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform><ScaleTransform/></Image.RenderTransform>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeKind}" Value="icon">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource BadgePop}"/></DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Ellipse Width="12" Height="12" Fill="{DynamicResource BadgeRed}" Stroke="{DynamicResource Surface}" StrokeThickness="1.5"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeKind}" Value="dot">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource BadgePop}"/></DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                            <!-- running dots: under the icon, or beside it for a side dock -->
                            <ItemsControl ItemsSource="{Binding DotCount, Converter={x:Static local:DotsConverter.Instance}}"
                                          HorizontalAlignment="{Binding DotsHAlign, RelativeSource={RelativeSource AncestorType=Window}}"
                                          VerticalAlignment="{Binding DotsVAlign, RelativeSource={RelativeSource AncestorType=Window}}" Margin="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="{Binding DotsOrientation, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="4" Height="4" Margin="1.5" Fill="{DynamicResource Accent}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- wants attention: a pulsing ring, like the taskbar's flashing button -->
                            <Border CornerRadius="{DynamicResource RadiusM}" BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                    Background="{DynamicResource AccentSoft}" IsHitTestVisible="False"
                                    Visibility="{Binding NeedsAttention, Converter={StaticResource Vis}}">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
